# RevTrack API environment template.
# Generate DIFFERENT random values, at least 24 characters.
# export REVTRACK_DEMO_TOKEN=$(openssl rand -hex 24)
# export REVTRACK_DEVICE_TOKEN=$(openssl rand -hex 24)
REVTRACK_DEMO_TOKEN=replace-with-random-user-token
REVTRACK_DEVICE_TOKEN=replace-with-random-device-token

# Local development defaults to loopback. Cloud/container deployments should
# explicitly set HOST=0.0.0.0 and expose the service through HTTPS at the edge.
HOST=127.0.0.1
PORT=8080

# Optional: atomically replace a local snapshot, no credentials stored in it.
# REVTRACK_DATA_FILE=/private/tmp/revtrack-demo/state.json

# Only required for Flutter web development; use its exact origin.
# REVTRACK_WEB_ORIGIN=http://localhost:5173
